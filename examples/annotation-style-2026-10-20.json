  {
    "Code": "label",
    "Id": "df8a225e-7a71-5891-bee5-b6860ea32fd3",
    "Properties": {
      "__type": "DataFlowAnnotationLabelProperties:#Infinis.DataFlows",
      "_AppVersion": "2026.4.204.0",
      "_PatchVersion": 0,
      "IsLocked": false,
      "Left": 1666,
      "Top": 493,
